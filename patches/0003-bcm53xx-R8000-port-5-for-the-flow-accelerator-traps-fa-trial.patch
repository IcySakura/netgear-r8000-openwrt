From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Myles Liu <lyx981mike@gmail.com>
Date: Tue, 24 Nov 2026 16:57:07 -0800
Subject: [PATCH] bcm53xx: R8000: port 5 for the flow accelerator traps,
 one-shot FA trial

Enable switch port 5 (gmac0) as the second CPU port the flow accelerator
series uses for its TTL/FIN/RST traps (the R8000 already uses port 8 as its
CPU port). Add a preinit hook that, when /etc/fa-trial exists, resets
flow_offloading_hw to 0 in the saved config right after the
99_20_flow_accel hook has used it, so a hang or watchdog reset after
enabling the accelerator boots the next time without it.
---
 .../base-files/lib/preinit/99_30_fa_trial     | 14 ++++++++++
 ...ort-5-for-the-flow-accelerator-traps.patch | 27 +++++++++++++++++++
 2 files changed, 41 insertions(+)
 create mode 100644 target/linux/bcm53xx/base-files/lib/preinit/99_30_fa_trial
 create mode 100644 target/linux/bcm53xx/patches-6.18/398-ARM-dts-BCM5301X-R8000-add-port-5-for-the-flow-accelerator-traps.patch

diff --git a/target/linux/bcm53xx/base-files/lib/preinit/99_30_fa_trial b/target/linux/bcm53xx/base-files/lib/preinit/99_30_fa_trial
new file mode 100644
index 0000000000..2713711f47
--- /dev/null
+++ b/target/linux/bcm53xx/base-files/lib/preinit/99_30_fa_trial
@@ -0,0 +1,14 @@
+# One-shot trial of the flow accelerator (R8000 experimental build).
+# If /etc/fa-trial exists, the 99_20_flow_accel hook has just used the
+# committed flow_offloading_hw=1 for this boot; turn the option back off in
+# the saved config right away, so that any hang, panic or watchdog reset
+# boots the next time with the regular tag and no accelerator.
+fa_trial() {
+	[ -f /etc/fa-trial ] || return 0
+	rm -f /etc/fa-trial
+	uci -q set firewall.@defaults[0].flow_offloading_hw=0
+	uci -q commit firewall
+	echo "fa-trial: accelerator tag kept for this boot only; flow_offloading_hw reset to 0 in config" > /dev/kmsg
+	touch /tmp/fa-trial-active
+}
+boot_hook_add preinit_main fa_trial
diff --git a/target/linux/bcm53xx/patches-6.18/398-ARM-dts-BCM5301X-R8000-add-port-5-for-the-flow-accelerator-traps.patch b/target/linux/bcm53xx/patches-6.18/398-ARM-dts-BCM5301X-R8000-add-port-5-for-the-flow-accelerator-traps.patch
new file mode 100644
index 0000000000..cb7db40810
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/398-ARM-dts-BCM5301X-R8000-add-port-5-for-the-flow-accelerator-traps.patch
@@ -0,0 +1,27 @@
+From: Myles Liu <lyx981mike@gmail.com>
+Subject: [PATCH] ARM: dts: BCM5301X: R8000: add port 5 for the flow
+ accelerator traps
+
+The Netgear R8000 (BCM4709A0, chip id 53010, "found switch: BCM53012,
+rev 5") already uses switch port 8 (gmac2) as its CPU port, and its
+port 5 (gmac0) is described with a fixed link but disabled. Enable it
+as a second CPU port, as the EA6900 and RT-N18U patches of the flow
+accelerator series do: b53 redirects the frames the accelerator in front
+of port 8 cannot handle (TTL 0/1, TCP FIN and RST) to it. The switch
+boots with the regular tag; the bcm53xx preinit hook moves it to the
+prepended tag only when flow offloading and hardware flow offloading
+are both on.
+
+Signed-off-by: Myles Liu <lyx981mike@gmail.com>
+---
+--- a/arch/arm/boot/dts/broadcom/bcm4709-netgear-r8000.dts
++++ b/arch/arm/boot/dts/broadcom/bcm4709-netgear-r8000.dts
+@@ -224,8 +224,6 @@
+ 		};
+ 
+ 		port@5 {
+-			status = "disabled";
+-
+ 			fixed-link {
+ 				speed = <1000>;
+ 				full-duplex;
