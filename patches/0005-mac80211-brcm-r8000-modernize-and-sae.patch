From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Myles Liu <lyx981mike@gmail.com>
Date: Fri, 27 Nov 2026 13:20:53 -0800
Subject: [PATCH] mac80211: brcm: modernize BCM43602 offloads, DFS, survey, and
 SAE

Add patch 880 enabling BCM43602 hardware-offloaded features on R8000:
- Live airtime & noise survey via chanim_stats v2 (dump_survey)
- 2.4 GHz explicit HT beamforming (txbf_ht_enable=1) and 256-QAM (vht_features=3)
- 802.11e QBSS Load IE (bssload=1) and Cortex-R4 Airtime Fairness (taf)
- Hardware-offloaded DFS (radar_detect_widths + WLC_SET_RADAR/SPECT)
- Auto-detected WPA3-SAE external auth support for the Cortex-R4 SAE patch
- Allow DTS country ccode/rev overrides when country_abbrev matches NVRAM
---
 ...880-brcmfmac-r8000-modernize-and-sae.patch | 391 ++++++++++++++++++
 1 file changed, 391 insertions(+)
 create mode 100644 package/kernel/mac80211/patches/brcm/880-brcmfmac-r8000-modernize-and-sae.patch

diff --git a/package/kernel/mac80211/patches/brcm/880-brcmfmac-r8000-modernize-and-sae.patch b/package/kernel/mac80211/patches/brcm/880-brcmfmac-r8000-modernize-and-sae.patch
new file mode 100644
index 0000000000..8b35727c42
--- /dev/null
+++ b/package/kernel/mac80211/patches/brcm/880-brcmfmac-r8000-modernize-and-sae.patch
@@ -0,0 +1,391 @@
+From: Myles Liu <lyx981mike@gmail.com>
+Subject: [PATCH] brcmfmac: modernize BCM43602 offloads, DFS, survey, and SAE external auth
+
+Enable hardware-offloaded modern Wi-Fi features on BCM43602 (7.35.177.56):
+- Non-disruptive live airtime and noise telemetry via chanim_stats v2
+  (monotonic cumulative survey counters for dump_survey / iwinfo / UniFi)
+- 2.4 GHz explicit HT beamforming (txbf_ht_enable=1) and 256-QAM (vht_features=3)
+- 802.11e QBSS Load IE in beacons (bssload=1)
+- Cortex-R4 hardware Traffic/Airtime Fairness scheduler (taf enable 1)
+- Hardware-offloaded DFS (radar_detect_widths + WLC_SET_SPECT_MANAGMENT/RADAR)
+- Auto-detected WPA3-SAE external auth support (sae_rsnie + RSNXE H2E, sae_tx,
+  BRCMF_E_AUTH_IND relay, NL80211_FEATURE_SAE) when paired with the Cortex-R4
+  TCAM SAE firmware patch; gracefully inactive on stock firmware
+- Allow brcmf_translate_country_code() to apply DTS ccode/rev overrides even
+  when country_abbrev matches the NVRAM boot default
+
+Signed-off-by: Myles Liu <lyx981mike@gmail.com>
+---
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h
+@@ -398,6 +398,12 @@
+ 	struct brcmf_cfg80211_wowl wowl;
+ 	struct brcmf_pno_info *pno;
+ 	u8 ac_priority[MAX_8021D_PRIO];
++	u64 survey_active_ms;
++	u64 survey_busy_ms;
++	u64 survey_rx_ms;
++	u64 survey_tx_ms;
++	unsigned long survey_last_jiffies;
++	u16 survey_last_chspec;
+ };
+ 
+ /**
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+@@ -4815,6 +4815,21 @@
+ 			goto exit;
+ 		}
+ 	}
++	/* If SAE AKM is configured and firmware supports custom sae_rsnie,
++	 * remap WPA3_AUTH_SAE_PSK to WPA2_AUTH_PSK | WPA2_AUTH_PSK_SHA256
++	 * so legacy 7.35 firmware accepts wpa_auth while our SAE hook handles
++	 * RSN IE emission, AKM-8 association, and SAE Auth frame relay.
++	 */
++	if (wpa_auth & WPA3_AUTH_SAE_PSK) {
++		if (!brcmf_fil_bsscfg_data_set(ifp, "sae_rsnie", (void *)wpa_ie,
++					       len)) {
++			wpa_auth &= ~WPA3_AUTH_SAE_PSK;
++			wpa_auth |= WPA2_AUTH_PSK | WPA2_AUTH_PSK_SHA256;
++		}
++	} else {
++		u8 zero = 0;
++		(void)brcmf_fil_bsscfg_data_set(ifp, "sae_rsnie", &zero, 1);
++	}
+ 	/* set upper-layer auth */
+ 	err = brcmf_fil_bsscfg_int_set(ifp, "wpa_auth", wpa_auth);
+ 	if (err < 0) {
+@@ -5152,8 +5167,35 @@
+ 			err = brcmf_configure_wpaie(ifp, tmp_ie, true);
+ 			if (err < 0)
+ 				return err;
++
++			/* If SAE H2E RSNXE (EID 244) is present alongside SAE RSN IE,
++			 * append it so beacons & probe responses advertise H2E support.
++			 */
++			{
++				const struct brcmf_tlv *rsnx_ie;
++				u8 cur_ie[80] = {};
++				size_t rsn_len = rsn_ie->len + TLV_HDR_LEN;
++
++				rsnx_ie = brcmf_parse_tlvs((u8 *)settings->beacon.tail,
++							   settings->beacon.tail_len,
++							   WLAN_EID_RSNX);
++				if (rsnx_ie &&
++				    rsn_len + rsnx_ie->len + TLV_HDR_LEN <= sizeof(cur_ie) &&
++				    !brcmf_fil_bsscfg_data_get(ifp, "sae_rsnie",
++							       cur_ie, sizeof(cur_ie)) &&
++				    cur_ie[0] == WLAN_EID_RSN) {
++					memcpy(cur_ie, rsn_ie, rsn_len);
++					memcpy(cur_ie + rsn_len, rsnx_ie,
++					       rsnx_ie->len + TLV_HDR_LEN);
++					(void)brcmf_fil_bsscfg_data_set(
++						ifp, "sae_rsnie", cur_ie,
++						rsn_len + rsnx_ie->len + TLV_HDR_LEN);
++				}
++			}
+ 		}
+ 	} else {
++		u8 zero = 0;
++		(void)brcmf_fil_bsscfg_data_set(ifp, "sae_rsnie", &zero, 1);
+ 		brcmf_dbg(TRACE, "No WPA(2) IEs found\n");
+ 		brcmf_configure_opensecurity(ifp);
+ 	}
+@@ -5295,6 +5337,13 @@
+ 			goto exit;
+ 		}
+ 		if (!mbss) {
++			if (wiphy->bands[NL80211_BAND_5GHZ] &&
++			    brcmf_feat_is_enabled(ifp, BRCMF_FEAT_DOT11H)) {
++				bool is_dfs = !!(settings->chandef.chan->flags &
++						 IEEE80211_CHAN_RADAR);
++				(void)brcmf_fil_cmd_int_set(ifp, 244 /* WLC_SET_SPECT_MANAGMENT */, 1);
++				(void)brcmf_fil_cmd_int_set(ifp, 243 /* WLC_SET_RADAR */, is_dfs ? 1 : 0);
++			}
+ 			/* Firmware 10.x requires setting channel after enabling
+ 			 * AP and before bringing interface up.
+ 			 */
+@@ -5627,6 +5676,15 @@
+ 					    ie_len);
+ 		cfg80211_mgmt_tx_status(wdev, *cookie, buf, len, true,
+ 					GFP_KERNEL);
++	} else if (ieee80211_is_auth(mgmt->frame_control) &&
++		   len >= DOT11_MGMT_HDR_LEN + 6 &&
++		   le16_to_cpu(mgmt->u.auth.auth_alg) == WLAN_AUTH_SAE) {
++		err = brcmf_fil_bsscfg_data_set(vif->ifp, "sae_tx",
++						(void *)buf, len);
++		if (err)
++			bphy_err(drvr, "sae_tx failed (%d)\n", err);
++		cfg80211_mgmt_tx_status(wdev, *cookie, buf, len, err == 0,
++					GFP_KERNEL);
+ 	} else if (ieee80211_is_action(mgmt->frame_control)) {
+ 		if (len > BRCMF_FIL_ACTION_FRAME_SIZE + DOT11_MGMT_HDR_LEN) {
+ 			bphy_err(drvr, "invalid action frame length\n");
+@@ -6817,8 +6875,42 @@
+ 	conf->retry_long = (u32)-1;
+ }
+ 
++static s32
++brcmf_notify_sae_auth_ind(struct brcmf_if *ifp,
++			  const struct brcmf_event_msg *e, void *data)
++{
++	struct brcmf_cfg80211_info *cfg = ifp->drvr->config;
++	struct wireless_dev *wdev = &ifp->vif->wdev;
++	struct brcmu_chan ch;
++	int freq = 0;
++
++	if (e->auth_type != WLAN_AUTH_SAE || e->datalen < DOT11_MGMT_HDR_LEN + 6)
++		return 0;
++
++	if (wdev->links[0].ap.chandef.chan) {
++		freq = wdev->links[0].ap.chandef.chan->center_freq;
++	} else {
++		u32 chspec = 0;
++		if (!brcmf_fil_iovar_int_get(ifp, "chanspec", &chspec)) {
++			ch.chspec = (u16)chspec;
++			cfg->d11inf.decchspec(&ch);
++			freq = ieee80211_channel_to_frequency(
++				ch.control_ch_num,
++				ch.band == BRCMU_CHAN_BAND_2G ?
++					NL80211_BAND_2GHZ : NL80211_BAND_5GHZ);
++		}
++	}
++	if (!freq)
++		return 0;
++
++	cfg80211_rx_mgmt(wdev, freq, 0, data, e->datalen, 0);
++	return 0;
++}
++
+ static void brcmf_register_event_handlers(struct brcmf_cfg80211_info *cfg)
+ {
++	brcmf_fweh_register(cfg->pub, BRCMF_E_AUTH_IND,
++			    brcmf_notify_sae_auth_ind);
+ 	brcmf_fweh_register(cfg->pub, BRCMF_E_LINK,
+ 			    brcmf_notify_connect_status);
+ 	brcmf_fweh_register(cfg->pub, BRCMF_E_DEAUTH_IND,
+@@ -7584,6 +7676,11 @@
+ 	}
+ 	combo[c].n_limits = i;
+ 	combo[c].limits = c0_limits;
++	if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_DOT11H))
++		combo[c].radar_detect_widths = BIT(NL80211_CHAN_WIDTH_20_NOHT) |
++					       BIT(NL80211_CHAN_WIDTH_20) |
++					       BIT(NL80211_CHAN_WIDTH_40) |
++					       BIT(NL80211_CHAN_WIDTH_80);
+ 
+ 	if (p2p && !rsdb) {
+ 		c++;
+@@ -7623,6 +7720,11 @@
+ 		combo[c].max_interfaces = 4 + mon_flag;
+ 		combo[c].n_limits = i;
+ 		combo[c].limits = mbss_limits;
++		if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_DOT11H))
++			combo[c].radar_detect_widths = BIT(NL80211_CHAN_WIDTH_20_NOHT) |
++						       BIT(NL80211_CHAN_WIDTH_20) |
++						       BIT(NL80211_CHAN_WIDTH_40) |
++						       BIT(NL80211_CHAN_WIDTH_80);
+ 	}
+ 
+ 	wiphy->n_iface_combinations = n_combos;
+@@ -7753,6 +7855,14 @@
+ 	}
+ 	if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_SAE_EXT))
+ 		wiphy->features |= NL80211_FEATURE_SAE;
++	else {
++		u8 probe[8] = {};
++		if (!brcmf_fil_bsscfg_data_get(ifp, "sae_rsnie", probe,
++					       sizeof(probe))) {
++			wiphy->features |= NL80211_FEATURE_SAE;
++			brcmf_info("Firmware SAE external auth patch detected\n");
++		}
++	}
+ 	wiphy->mgmt_stypes = brcmf_txrx_stypes;
+ 	wiphy->max_remain_on_channel_duration = 5000;
+ 	if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_PNO)) {
+@@ -8009,14 +8119,13 @@
+ 	s32 found_index;
+ 	int i;
+ 
+-	if ((alpha2[0] == ccreq->country_abbrev[0]) &&
+-	    (alpha2[1] == ccreq->country_abbrev[1])) {
+-		brcmf_dbg(TRACE, "Country code already set\n");
+-		return -EAGAIN;
+-	}
+-
+ 	country_codes = drvr->settings->country_codes;
+ 	if (!country_codes) {
++		if ((alpha2[0] == ccreq->country_abbrev[0]) &&
++		    (alpha2[1] == ccreq->country_abbrev[1])) {
++			brcmf_dbg(TRACE, "Country code already set\n");
++			return -EAGAIN;
++		}
+ 		if (brmcf_use_iso3166_ccode_fallback(drvr)) {
+ 			brcmf_dbg(TRACE, "No country codes configured for device, using ISO3166 code and 0 rev\n");
+ 			memset(ccreq, 0, sizeof(*ccreq));
+@@ -8046,6 +8155,13 @@
+ 		brcmf_dbg(TRACE, "No country code match found\n");
+ 		return -EINVAL;
+ 	}
++	if ((alpha2[0] == ccreq->country_abbrev[0]) &&
++	    (alpha2[1] == ccreq->country_abbrev[1]) &&
++	    !strncmp(ccreq->ccode, country_codes->table[found_index].cc, 2) &&
++	    le32_to_cpu(ccreq->rev) == country_codes->table[found_index].rev) {
++		brcmf_dbg(TRACE, "Country code already set\n");
++		return -EAGAIN;
++	}
+ 	memset(ccreq, 0, sizeof(*ccreq));
+ 	ccreq->rev = cpu_to_le32(country_codes->table[found_index].rev);
+ 	memcpy(ccreq->ccode, country_codes->table[found_index].cc,
+@@ -8185,6 +8301,103 @@
+ 	return err;
+ }
+ 
++struct brcmf_chanim_stats_v2 {
++	__le32 glitchcnt;
++	__le32 badplcp;
++	u8 ccastats[9]; /* 0:TX, 1:INBSS, 2:OBSS, 3:NOCAT, 4:NOPKT, 5:DOZE, 6:TXOP */
++	s8 bgnoise;
++	__le16 chanspec;
++	__le32 timestamp;
++	__le32 bcn_cnt;
++	u8 pad[8];
++} __packed;
++
++struct brcmf_wl_chanim_stats {
++	__le32 buflen;
++	__le32 version;
++	__le32 count;
++	struct brcmf_chanim_stats_v2 stats[1];
++} __packed;
++
++static int
++brcmf_cfg80211_dump_survey_chanim(struct wiphy *wiphy, struct net_device *ndev,
++				  int idx, struct survey_info *info)
++{
++	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
++	struct brcmf_if *ifp = netdev_priv(ndev);
++	struct brcmf_wl_chanim_stats resp;
++	struct brcmu_chan ch;
++	enum nl80211_band band;
++	unsigned long now = jiffies;
++	u32 dt_ms, tx, rx, txop, busy;
++	u16 chspec;
++	int freq, err;
++
++	if (idx != 0)
++		return -ENOENT;
++
++	memset(&resp, 0, sizeof(resp));
++	resp.buflen = cpu_to_le32(sizeof(resp));
++	resp.count = cpu_to_le32(1);
++
++	err = brcmf_fil_iovar_data_get(ifp, "chanim_stats", &resp, sizeof(resp));
++	if (err || le32_to_cpu(resp.version) != 2 || le32_to_cpu(resp.count) < 1)
++		return -ENOENT;
++
++	chspec = le16_to_cpu(resp.stats[0].chanspec);
++	if (!chspec)
++		return -ENOENT;
++
++	ch.chspec = chspec;
++	cfg->d11inf.decchspec(&ch);
++	band = (ch.band == BRCMU_CHAN_BAND_2G) ? NL80211_BAND_2GHZ : NL80211_BAND_5GHZ;
++	freq = ieee80211_channel_to_frequency(ch.control_ch_num, band);
++	info->channel = ieee80211_get_channel(wiphy, freq);
++	if (!info->channel)
++		return -ENOENT;
++
++	tx = min_t(u32, 100, resp.stats[0].ccastats[0]);
++	rx = min_t(u32, 100, resp.stats[0].ccastats[1]);
++	txop = min_t(u32, 100, resp.stats[0].ccastats[6]);
++	busy = max_t(u32, min_t(u32, 100, tx + rx), 100 - txop);
++
++	if (!cfg->survey_last_jiffies || cfg->survey_last_chspec != chspec) {
++		cfg->survey_active_ms = 0;
++		cfg->survey_busy_ms = 0;
++		cfg->survey_rx_ms = 0;
++		cfg->survey_tx_ms = 0;
++		cfg->survey_last_chspec = chspec;
++		dt_ms = 1000;
++	} else {
++		dt_ms = jiffies_to_msecs(now - cfg->survey_last_jiffies);
++		if (dt_ms > 60000)
++			dt_ms = 60000;
++	}
++	cfg->survey_last_jiffies = now;
++
++	cfg->survey_active_ms += dt_ms;
++	cfg->survey_busy_ms += (u64)dt_ms * busy / 100;
++	cfg->survey_rx_ms += (u64)dt_ms * rx / 100;
++	cfg->survey_tx_ms += (u64)dt_ms * tx / 100;
++
++	info->filled = SURVEY_INFO_IN_USE |
++		       SURVEY_INFO_TIME |
++		       SURVEY_INFO_TIME_BUSY |
++		       SURVEY_INFO_TIME_RX |
++		       SURVEY_INFO_TIME_TX;
++	info->time = cfg->survey_active_ms;
++	info->time_busy = cfg->survey_busy_ms;
++	info->time_rx = cfg->survey_rx_ms;
++	info->time_tx = cfg->survey_tx_ms;
++
++	if (resp.stats[0].bgnoise < 0) {
++		info->noise = resp.stats[0].bgnoise;
++		info->filled |= SURVEY_INFO_NOISE_DBM;
++	}
++
++	return 0;
++}
++
+ static int
+ brcmf_cfg80211_dump_survey(struct wiphy *wiphy, struct net_device *ndev,
+ 			   int idx, struct survey_info *info)
+@@ -8448,8 +8661,17 @@
+ 		ops->set_rekey_data = brcmf_cfg80211_set_rekey_data;
+ #endif
+ #if !defined(CONFIG_ARCH_BCM2835)
+-	if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_DUMP_OBSS))
++	if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_DUMP_OBSS)) {
+ 		ops->dump_survey = brcmf_cfg80211_dump_survey;
++	} else {
++		struct brcmf_wl_chanim_stats cprobe = {
++			.buflen = cpu_to_le32(sizeof(cprobe)),
++			.count = cpu_to_le32(1),
++		};
++		if (!brcmf_fil_iovar_data_get(ifp, "chanim_stats", &cprobe, sizeof(cprobe)) &&
++		    le32_to_cpu(cprobe.version) == 2)
++			ops->dump_survey = brcmf_cfg80211_dump_survey_chanim;
++	}
+ #endif /* CONFIG_ARCH_BCM2835 */
+ 
+ 	err = wiphy_register(wiphy);
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
+@@ -489,8 +489,25 @@
+ 		goto done;
+ 	}
+ 
+-	/* Enable tx beamforming, errors can be ignored (not supported) */
++	/* Enable tx beamforming, 2.4G 256-QAM, QBSS Load IE, and firmware TAF, errors ignored */
+ 	(void)brcmf_fil_iovar_int_set(ifp, "txbf", 1);
++	(void)brcmf_fil_iovar_int_set(ifp, "txbf_ht_enable", 1);
++	(void)brcmf_fil_iovar_int_set(ifp, "vht_features", 3);
++	(void)brcmf_fil_iovar_int_set(ifp, "bssload", 1);
++	{
++		struct {
++			u8 ea[6];
++			__le16 version;
++			u8 pad[12];
++			char text[16];
++		} __packed taf_req = {
++			.ea = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff },
++			.version = cpu_to_le16(1),
++		};
++		memcpy(taf_req.text, "enable\0" "1\0", 9);
++		(void)brcmf_fil_iovar_data_set(ifp, "taf", &taf_req,
++					       sizeof(taf_req));
++	}
+ done:
+ 	return err;
+ }
