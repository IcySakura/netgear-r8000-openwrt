# Netgear R8000 (Nighthawk X6, BCM4709A0) - diffconfig, expanded by "make defconfig".
# Package selections beyond this base belong in configs/base.packages and
# profiles/*.packages (see scripts/profile.sh).
#
# bcm53xx has no hardware NAT/packet-offload engine (no "NSS"/"PPE" equivalent
# exists on Broadcom silicon here - see README). This build relies on the
# generic software fastpath (firewall.@defaults[0].flow_offloading, turned on
# at first boot by overlays/common/etc/uci-defaults/10-flow-offloading)
# instead, and does NOT turn on flow_offloading_hw: there is no hardware
# flowtable for it to offload to.
CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_netgear_r8000=y

# Full wpad (802.11k/v, WPA3-SAE where the radio supports it) in place of
# wpad-basic-*: a hard requirement of antoniocosta/unifi-openwrt (see
# docs/unifi-adoption.md), and generally wanted together with the guest
# network / MBSS fix in patches/0002. This is a straight swap of which wpad
# package provides "wpad", so it lives here rather than in a profile.
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
