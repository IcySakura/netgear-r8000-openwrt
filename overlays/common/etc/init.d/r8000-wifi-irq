#!/bin/sh /etc/rc.common
# Balance BCM43602 PCIe Wi-Fi and GMAC IRQs across both Cortex-A9 cores on R8000:
# - First brcmf_pcie_intr (pcie0, 5 GHz High) + eth0 (FA/WAN) -> CPU0 (mask 1)
# - Second brcmf_pcie_intr (pcie1, 2.4 GHz + 5 GHz Low) + eth2 (IMP0 switch) -> CPU1 (mask 2)

START=99

start() {
	local idx=0
	local irq
	for irq in $(awk '/brcmf_pcie_intr/ { sub(":", "", $1); print $1 }' /proc/interrupts); do
		idx=$((idx + 1))
		if [ "$idx" -eq 1 ]; then
			echo 1 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
		else
			echo 2 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
		fi
	done
	for irq in $(awk '/eth0/ { sub(":", "", $1); print $1 }' /proc/interrupts); do
		echo 1 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
	done
	for irq in $(awk '/eth2/ { sub(":", "", $1); print $1 }' /proc/interrupts); do
		echo 2 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
	done
}
